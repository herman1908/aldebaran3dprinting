# Environment variables — salin jadi .env (sudah otomatis dibaca saat lokal)
# lalu isi nilainya. Di Vercel: isi lewat Project > Settings > Environment Variables.

# Password login panel admin (/admin) — cadangan pertama kali.
# Setelah Supabase aktif, password bisa diganti dari /admin/password.php dan
# disimpan (hash) di tabel admin_akun; nilai env ini tidak dipakai lagi.
ADMIN_PASSWORD=

# Supabase — database persisten agar admin bisa menulis dari web online.
# Ambil di dashboard Supabase: Project Settings > API.
# SUPABASE_URL contoh: https://abcdefghijkl.supabase.co (tanpa /rest/v1)
# SUPABASE_SERVICE_KEY = service_role key. RAHASIA: hanya untuk server (PHP),
# jangan pernah dimasukkan ke JavaScript/HTML.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Nomor WhatsApp toko (tujuan checkout & konsultasi). Format bebas:
# 08xx, 62xx, atau +62xx — otomatis dirapikan. Default: 6281234567890.
WHATSAPP_TOKO=

# Cloudinary — ambil dari dashboard cloudinary.com (Settings > Cloud name)
# dan buat Upload preset bertipe UNSIGNED (Settings > Upload).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Folder Media Library tujuan upload. Dibuat otomatis saat upload pertama.
# Di project ini dipakai "ruang-3d". Kosongkan untuk upload ke root.
CLOUDINARY_FOLDER=ruang-3d

# Secret untuk menandatangani cookie keranjang/CSRF/admin.
# Isi di Vercel agar login & keranjang tetap valid antar-deploy.
# Buat acak, contoh: php -r "echo bin2hex(random_bytes(24));"
APP_SECRET=
