# Environment variables — salin jadi .env (sudah otomatis dibaca saat lokal)
# lalu isi nilainya. Di Vercel: isi lewat Project > Settings > Environment Variables.

# Password login panel admin (/admin). Wajib diisi agar admin aktif.
ADMIN_PASSWORD=

# Cloudinary — ambil dari dashboard cloudinary.com (Settings > Cloud name)
# dan buat Upload preset bertipe UNSIGNED (Settings > Upload).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Secret untuk menandatangani cookie keranjang/CSRF/admin.
# Buat acak, contoh: php -r "echo bin2hex(random_bytes(24));"
APP_SECRET=
